{
  "name": "relayforge",
  "version": "1.0.0-rc.1",
  "description": "RelayForge is a safe, headless AI agent team orchestrator with isolated git worktrees, independent review, deterministic verification, structured adapters, and an optional tmux viewport.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/arbazkhan971/loop-orchestrator#readme",
  "bugs": {
    "url": "https://github.com/arbazkhan971/loop-orchestrator/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arbazkhan971/loop-orchestrator.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "default": "./dist/cli.js"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "import": "./dist/observability/index.js",
      "default": "./dist/observability/index.js"
    },
    "./observability/control-store-adapter": {
      "types": "./dist/observability/control-store-adapter.d.ts",
      "import": "./dist/observability/control-store-adapter.js",
      "default": "./dist/observability/control-store-adapter.js"
    },
    "./control-room": {
      "types": "./dist/control-room/index.d.ts",
      "import": "./dist/control-room/index.js",
      "default": "./dist/control-room/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "relayforge": "./dist/cli.js",
    "loop": "./dist/cli.js",
    "loop-orchestrator": "./dist/cli.js"
  },
  "files": [
    "assets",
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "prepack": "npm run build",
    "validate": "npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "ai-agents",
    "agent-orchestrator",
    "tmux-orchestrator",
    "tmux",
    "claude-code",
    "claude",
    "codex",
    "openai-codex",
    "gemini-cli",
    "gemini",
    "multi-agent",
    "multi-agent-system",
    "agentic-coding",
    "coding-agent",
    "autonomous-coding-agents",
    "autonomous-agents",
    "ai-engineering-team",
    "ai-team",
    "devtools",
    "developer-tools",
    "terminal-agents",
    "terminal",
    "cli",
    "workflow-automation",
    "github-automation",
    "software-engineering-agents",
    "ai-code-review",
    "ai-workflow",
    "llm-agents"
  ],
  "engines": {
    "node": "20.x || >=22"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "commander": "^14.0.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  }
}
